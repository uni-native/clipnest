{
  "name": "pasteman",
  "productName": "PasteMan",
  "version": "0.1.1",
  "description": "PasteMan —— 本地优先的智能剪贴板管理器",
  "main": "./out/main/index.js",
  "private": true,
  "author": "liuhao",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "electron-vite build && electron-builder --win nsis portable --x64",
    "pack:win": "electron-vite build && electron-builder --win --x64 --dir",
    "test:intelligence": "node --no-warnings --experimental-strip-types scripts/test-intelligence.mjs",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "smoke": "electron-vite build && electron . --smoke"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.6.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "koffi": "^2.11.0",
    "pdfjs-dist": "^5.6.205",
    "pinia": "^4.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.pasteman.app",
    "productName": "PasteMan",
    "asar": true,
    "directories": {
      "output": "release2"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/iconTemplate_win.png",
        "to": "iconTemplate_win.png"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "PasteMan-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PasteMan"
    },
    "portable": {
      "artifactName": "PasteMan-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/uni-native/clipnest/releases/latest/download"
      }
    ],
    "asarUnpack": [
      "out/main/preview-worker.js",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/@napi-rs/**/*"
    ]
  }
}

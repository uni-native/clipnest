[
  {"text":"复制，不该打断思考。","start":0.00,"end":2.20},
  {"text":"剪巢，让每一次复制，自动归巢。","start":2.20,"end":5.30},
  {"text":"它理解你正在填写什么，并把最合适的内容，送到指尖。","start":5.30,"end":10.35},
  {"text":"一天复制了什么，哪些值得保留，一眼看清。","start":10.35,"end":14.55},
  {"text":"所有数据，只留在本机。","start":14.55,"end":16.75},
  {"text":"剪巢。把零碎，收进秩序。","start":16.75,"end":19.22}
]
